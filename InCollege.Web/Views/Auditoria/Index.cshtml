@model IEnumerable<InCollege.Dominio.Modelos.Auditoria>

@{
    ViewData["Title"] = "Bitácora de Seguridad";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Security Log</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #0d0d0d;
            color: #ccc;
            font-family: 'Consolas', 'Courier New', monospace; /* Fuente tipo Hacker/Consola */
            padding: 30px;
            background-image: radial-gradient(#1a1a1a 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .log-container {
            max-width: 1400px;
            margin: 0 auto;
            border: 1px solid #333;
            border-radius: 8px;
            background-color: rgba(10, 10, 10, 0.95);
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
            overflow: hidden;
        }

        .log-header {
            background-color: #1a1a1a;
            padding: 15px 25px;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .terminal-title {
            color: #4ade80;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* TABLA DE LOGS */
        .table-logs { width: 100%; border-collapse: collapse; font-size: 0.9rem; }

        .table-logs th {
            text-align: left;
            padding: 12px 20px;
            color: #666;
            border-bottom: 1px solid #333;
            text-transform: uppercase;
        }

        .table-logs td {
            padding: 10px 20px;
            border-bottom: 1px solid #222;
            vertical-align: top;
        }

        .table-logs tr:hover { background-color: rgba(74, 222, 128, 0.05); }

        /* Colores según acción */
        .badge-log { padding: 2px 6px; border-radius: 3px; font-size: 0.75rem; border: 1px solid; }
        .action-create { color: #4ade80; border-color: #4ade80; background: rgba(74, 222, 128, 0.1); }
        .action-pay { color: #ffc107; border-color: #ffc107; background: rgba(255, 193, 7, 0.1); }
        .action-delete { color: #f87171; border-color: #f87171; background: rgba(248, 113, 113, 0.1); }

        .btn-close-log {
            color: #fff; text-decoration: none; border: 1px solid #555; padding: 5px 15px; border-radius: 4px; font-family: 'Segoe UI', sans-serif; font-size: 0.9rem;
        }
        .btn-close-log:hover { background-color: #333; }
    </style>
</head>
<body>

    <div class="log-container">
        <div class="log-header">
            <div>
                <i class="bi bi-shield-lock-fill text-success me-2"></i>
                <span class="terminal-title">SYSTEM SECURITY LOG</span>
            </div>
            <a href="/Home/PanelAdmin" class="btn-close-log">Cerrar / Volver</a>
        </div>

        <div class="table-responsive">
            <table class="table-logs">
                <thead>
                    <tr>
                        <th style="width: 180px;">FECHA / HORA</th>
                        <th style="width: 250px;">USUARIO</th>
                        <th style="width: 200px;">ACCIÓN</th>
                        <th>DETALLE DEL EVENTO</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td style="color: #888;">@log.Fecha.ToString("dd/MM/yy HH:mm:ss")</td>
                            <td class="text-white">@log.UsuarioEmail</td>
                            <td>
                                @if (log.Accion.Contains("NUEVO"))
                                {
                                    <span class="badge-log action-create">CREACIÓN</span>
                                }
                                else if (log.Accion.Contains("COBRO"))
                                {

                                    <span class="badge-log action-pay">FINANZAS</span>
                                }
                                else if (log.Accion.Contains("ELIMINAR"))
                                {

                                    <span class="badge-log action-delete">SEGURIDAD</span>
                                }
                                else
                                {

                                    <span class="badge-log" style="color:#aaa; border-color:#555;">@log.Accion</span>
                                }
                            </td>
                            <td style="color: #ccc;">@log.Detalle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>