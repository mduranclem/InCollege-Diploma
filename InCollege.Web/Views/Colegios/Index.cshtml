@using InCollege.Web.Models
@using Microsoft.AspNetCore.Http
@model IEnumerable<EscuelaViewModel>

@{
    ViewData["Title"] = "Cartera de Clientes";
    Layout = null; // Usamos el layout propio

    // Lógica para el botón volver según el rol
    // Lógica para el botón volver según el rol
    string rolUsuario = Context.Session.GetString("UsuarioRol");

    // CORRECCIÓN: Ahora el diseñador vuelve a /Disenos/Panel
    string linkVolver = "/Home/Index"; // Default Admin
    if (rolUsuario == "Disenador" || rolUsuario == "Diseñador")
    {
        linkVolver = "/Disenos/Panel";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cartera de Escuelas - InCollege</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-container {
            width: 95%;
            max-width: 1600px;
            margin: 0 auto;
            padding-top: 30px;
            padding-bottom: 50px;
        }

        .header-card {
            background-color: rgba(12, 12, 12, 0.98);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        }

        /* Tabla */
        .table-massive {
            width: 100%;
            border-collapse: collapse;
        }

            .table-massive th {
                background-color: rgba(255,255,255,0.05);
                color: #aaa;
                padding: 15px;
                text-transform: uppercase;
                font-size: 0.9rem;
                border-bottom: 2px solid #444;
                text-align: left;
            }

            .table-massive td {
                padding: 15px;
                color: white;
                border-bottom: 1px solid #333;
                vertical-align: middle;
                font-size: 1.1rem;
            }

            .table-massive tr:hover td {
                background-color: rgba(255, 255, 255, 0.05);
            }

        /* Botones */
        .btn-new {
            background-color: #1e6f42;
            color: white;
            border: none;
            font-weight: 800;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            display: inline-block;
        }

            .btn-new:hover {
                background-color: #145230;
                color: white;
            }

        .btn-back {
            background-color: transparent;
            border: 2px solid #555;
            color: #ddd;
            font-weight: 700;
            padding: 8px 20px;
            border-radius: 6px;
            text-decoration: none;
            display: inline-block;
        }

            .btn-back:hover {
                border-color: white;
                color: white;
                background-color: #222;
            }

        .badge-status {
            font-size: 0.9rem;
            padding: 5px 12px;
            border-radius: 4px;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>
<body>

    <div class="main-container">

        <div class="header-card mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold m-0 border-start border-5 border-success ps-3">CARTERA DE ESCUELAS</h2>
                <p class="text-secondary ms-4 mb-0 mt-1">Gestión de instituciones y clientes</p>
            </div>
            <div>
                <a href="@linkVolver" class="btn-back me-2"><i class="bi bi-arrow-left"></i> VOLVER</a>

                @if (rolUsuario == "Admin" || rolUsuario == "Vendedor")
                {
                    <a href="/Colegios/Crear" class="btn-new shadow"><i class="bi bi-plus-lg"></i> NUEVA ESCUELA</a>
                }
            </div>
        </div>

        <div class="header-card">
            <div class="table-responsive">
                <table class="table-massive">
                    <thead>
                        <tr>
                            <th>INSTITUCIÓN</th>
                            <th>CONTACTO</th>
                            <th>VENDEDOR</th>
                            <th>ESTADO COMERCIAL</th>
                            <th class="text-end">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="bi bi-building-slash display-1 opacity-25"></i>
                                    <p class="mt-3 fs-4">No hay escuelas registradas.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white fs-5">@item.Nombre</div>
                                        <div class="small text-secondary"><i class="bi bi-geo-alt-fill"></i> @item.Ciudad - @item.Direccion</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.ContactoNombre</div>
                                        <div class="small text-secondary"><i class="bi bi-telephone"></i> @item.Telefono</div>
                                    </td>
                                    <td class="text-info">@item.Vendedor</td>
                                    <td>
                                        @if (item.EstadoActual == "Firmado" || item.EstadoActual == "Activo")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success badge-status">
                                                <i class="bi bi-check-circle-fill"></i> CLIENTE ACTIVO
                                            </span>
                                        }
                                        else if (item.EstadoActual == "Perdido")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger badge-status">
                                                <i class="bi bi-x-circle-fill"></i> EX-PROSPECTO
                                            </span>
                                        }
                                        else if (item.EstadoActual == "Presupuesto")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning badge-status">
                                                <i class="bi bi-clock-history"></i> NEGOCIANDO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary badge-status">
                                                SIN GESTIÓN
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (rolUsuario == "Admin" || rolUsuario == "Vendedor")
                                        {
                                            <a href="/Colegios/Editar/@item.Id" class="btn btn-outline-warning btn-sm me-1" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form action="/Colegios/Eliminar" method="post" style="display:inline;" onsubmit="return confirm('¿Eliminar esta escuela? Se borrarán sus contratos.');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">Solo lectura</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>