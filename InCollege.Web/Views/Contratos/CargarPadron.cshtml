@model InCollege.Dominio.Modelos.Contrato
@{
    ViewData["Title"] = "Cargar Padrón"; Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
        }

        .padron-card {
            background-color: rgba(15,15,15,0.95);
            border: 1px solid #444;
            padding: 40px;
            max-width: 800px;
            margin: 50px auto;
            border-radius: 15px;
        }

        textarea {
            background-color: #111;
            color: white;
            border: 1px solid #555;
            font-size: 1.2rem;
            height: 300px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="padron-card">
            <h2 class="text-center fw-bold mb-4">CARGAR ALUMNOS: @Model.NombreColegio</h2>
            <p class="text-secondary text-center">Copia y pega la lista de nombres desde Excel o Word (uno por renglón).</p>

            <form action="/Contratos/GuardarPadron" method="post">
                <input type="hidden" name="contratoId" value="@Model.Id" />

                <div class="mb-4">
                    <textarea name="listaNombres" class="form-control" placeholder="Ejemplo:&#10;Juan Perez&#10;Maria Gomez&#10;Lucas Rodriguez"></textarea>
                </div>

                <button type="submit" class="btn btn-success w-100 py-3 fs-4 fw-bold">GUARDAR Y GENERAR CUENTAS</button>
            </form>
        </div>
    </div>
</body>
</html>
