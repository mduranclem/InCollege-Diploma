@model InCollege.Dominio.Modelos.Contrato

@{
    ViewData["Title"] = "Nuevo Contrato";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Nuevo Contrato</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* ESTILOS GENERALES */
        body {
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            padding: 40px 0;
            min-height: 100vh;
        }

        .form-card {
            background-color: rgba(15, 15, 15, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.9);
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .form-control, .form-select {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid #444;
            color: white;
            height: 50px;
            font-size: 1rem;
            padding-left: 15px;
            border-radius: 6px;
        }

            .form-control:focus, .form-select:focus {
                background-color: rgba(255, 255, 255, 0.1);
                border-color: #1e6f42;
                color: white;
                box-shadow: none;
            }

            /* Input Readonly (Vendedor Automático) */
            .form-control[readonly] {
                background-color: #080808;
                border-color: #1e6f42;
                color: #1e6f42;
                font-weight: bold;
                cursor: not-allowed;
            }

        textarea.form-control {
            height: 300px;
            font-family: monospace;
            resize: none;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .form-label {
            color: #aaa;
            font-size: 0.75rem;
            font-weight: 700;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        option {
            background-color: #111;
            color: white;
        }

        .btn-brand {
            background-color: #1e6f42;
            color: white;
            border: none;
            height: 55px;
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 2px;
            width: 100%;
            text-transform: uppercase;
            border-radius: 6px;
            transition: 0.3s;
            margin-top: 20px;
        }

            .btn-brand:hover {
                background-color: #145230;
                transform: scale(1.01);
                color: white;
            }

        .titulo-pag {
            font-size: 1.8rem;
            font-weight: 900;
            margin-bottom: 30px;
            border-left: 8px solid #1e6f42;
            padding-left: 15px;
            text-transform: uppercase;
        }

        .section-divider {
            border-bottom: 1px solid #333;
            margin: 20px 0 15px 0;
            padding-bottom: 5px;
            color: #1e6f42;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .link-cancelar {
            font-size: 0.9rem;
            color: #666;
            text-decoration: none;
            transition: 0.2s;
        }

            .link-cancelar:hover {
                color: #dc3545;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12">

                <div class="form-card">
                    <h2 class="titulo-pag">NUEVO CONTRATO</h2>

                    <form action="/Contratos/Crear" method="post">

                        <div class="row">
                            <div class="col-lg-8 border-end border-secondary pe-lg-5">

                                <div class="section-divider">Datos Comerciales</div>
                                <div class="row g-3">

                                    <div class="col-md-8">
                                        <label class="form-label text-warning">Institución (Seleccionar)</label>
                                        <select name="ColegioId" id="selectorColegio" class="form-select" required onchange="actualizarVendedor()">
                                            <option value="" data-vendedor="">-- Buscar Colegio --</option>
                                            @if (ViewBag.ColegiosData != null)
                                            {
                                                foreach (var item in ViewBag.ColegiosData)
                                                {
                                                    <option value="@item.Id" data-vendedor="@item.VendedorResponsable">@item.Nombre</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label text-success">Vendedor (Auto)</label>
                                        <input type="text" name="VendedorAsignado" id="inputVendedor" class="form-control" readonly placeholder="..." required />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label text-info">Origen del Contacto</label>
                                        <select name="OrigenContacto" class="form-select" required>
                                            <option value="">Seleccionar...</option>
                                            <option value="Instagram">Instagram / Redes</option>
                                            <option value="Vendedor">Vendedor (Propio)</option>
                                            <option value="Recomendado">Recomendación</option>
                                            <option value="Web">Página Web</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Pack / Diseño</label>
                                        <select name="ProductoId" class="form-select" asp-items="ViewBag.Productos" required>
                                            <option value="">Seleccionar...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Curso</label>
                                        <input type="text" name="Curso" class="form-control" placeholder="Ej: 5to" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">División</label>
                                        <input type="text" name="Division" class="form-control" placeholder="Ej: A" required>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Cant. Egresados</label>
                                        <input type="number" name="CantidadEgresados" class="form-control" min="1" required>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Año</label>
                                        <input type="number" name="AnioEgresados" class="form-control" value="@DateTime.Now.Year" required>
                                    </div>
                                </div>

                                <div class="section-divider mt-5">Precios y Financiación</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Precio Lista ($)</label>
                                        <input type="number" name="PrecioUnitario" class="form-control" placeholder="0.00" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-success">Precio Contado ($)</label>
                                        <input type="number" name="PrecioContado" class="form-control" placeholder="0.00">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-warning">Seña Mínima ($)</label>
                                        <input type="number" name="MontoSeña" class="form-control" placeholder="0.00" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Cantidad Cuotas</label>
                                        <input type="number" name="CantidadCuotas" class="form-control" placeholder="Ej: 6">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Valor Cuota ($)</label>
                                        <input type="number" name="MontoPorCuota" class="form-control" placeholder="0.00">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 ps-lg-4 mt-4 mt-lg-0">
                                <div class="section-divider text-white"><i class="bi bi-person-lines-fill me-2"></i> Carga Masiva</div>

                                <div class="alert alert-dark border-secondary p-2 mb-2" style="font-size: 0.75rem; color:#aaa;">
                                    <i class="bi bi-info-circle me-1"></i> Copia y pega la lista de alumnos.<br>
                                    <strong>Formato:</strong> Un nombre y apellido por renglón.
                                </div>

                                <textarea name="ListaAlumnos" class="form-control" placeholder="PEREZ JUAN&#10;GOMEZ MARIA&#10;LOPEZ LUCAS..." required></textarea>

                                <button type="submit" class="btn-brand shadow">
                                    CREAR CONTRATO
                                </button>
                                <div class="text-center mt-3">
                                    <a href="/Home/PanelAdmin" class="link-cancelar">Cancelar operación</a>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function actualizarVendedor() {
            var select = document.getElementById("selectorColegio");
            var input = document.getElementById("inputVendedor");

            // Obtener la opción seleccionada
            var opcion = select.options[select.selectedIndex];

            // Leer el atributo data-vendedor
            var vendedor = opcion.getAttribute("data-vendedor");

            if (vendedor && vendedor !== "") {
                input.value = vendedor;
            } else {
                input.value = "Sin Asignar";
            }
        }
    </script>

</body>
</html>