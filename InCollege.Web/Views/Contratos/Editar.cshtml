@model InCollege.Dominio.Modelos.Contrato
@{
    ViewData["Title"] = "Editar Contrato"; Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .form-card {
            background-color: rgba(15, 15, 15, 0.96);
            border: 1px solid #444;
            padding: 40px;
            border-radius: 15px;
            width: 100%;
            max-width: 1000px;
        }

        .form-control, .form-select {
            background-color: #111;
            border: 1px solid #555;
            color: white;
            height: 50px;
            font-size: 1.1rem;
        }

        .btn-update {
            background-color: #ffc107;
            color: #000;
            border: none;
            height: 55px;
            font-size: 1.2rem;
            font-weight: 800;
            width: 100%;
            border-radius: 6px;
        }

            .btn-update:hover {
                background-color: #e0a800;
            }

        label {
            color: #aaa;
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 0.9rem;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-card">
            <h2 class="fw-bold mb-4" style="border-left: 8px solid #ffc107; padding-left: 15px;">EDITAR CONTRATO</h2>
            <form action="/Contratos/Editar" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FechaCreacion" />
                <input type="hidden" asp-for="Estado" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Institución</label>
                        <select asp-for="ColegioId" class="form-select" asp-items="ViewBag.Colegios"></select>
                    </div>
                    <div class="col-md-6">
                        <label>Pack / Diseño</label>
                        <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.Productos"></select>
                    </div>

                    <div class="col-md-4"><label>Alumnos</label><input asp-for="CantidadEgresados" class="form-control"></div>
                    <div class="col-md-4"><label>Precio Lista</label><input asp-for="PrecioUnitario" class="form-control"></div>
                    <div class="col-md-4"><label>Precio Contado</label><input asp-for="PrecioContado" class="form-control"></div>

                    <div class="col-12"><hr class="border-secondary"></div>

                    <div class="col-md-4"><label>Seña</label><input asp-for="MontoSeña" class="form-control"></div>
                    <div class="col-md-4"><label>Cuotas</label><input asp-for="CantidadCuotas" class="form-control"></div>
                    <div class="col-md-4"><label>Valor Cuota</label><input asp-for="MontoPorCuota" class="form-control"></div>
                </div>

                <div class="mt-4 d-flex justify-content-between align-items-center">
                    <a href="/Contratos/Index" class="text-secondary text-decoration-none">Cancelar</a>
                    <button type="submit" class="btn btn-update w-50">ACTUALIZAR DATOS</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>