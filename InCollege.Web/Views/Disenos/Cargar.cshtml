@model InCollege.Dominio.Modelos.Contrato

@{
    ViewData["Title"] = "Subir Diseño";
    Layout = null; // Usamos el diseño personalizado
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Cargar Diseño - InCollege</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* --- ESTILOS GLOBAL --- */
        :root {
            --brand-green: #1e6f42;
            --brand-green-hover: #145230;
            --card-bg: rgba(18, 18, 18, 0.95);
            --text-silver: #cccccc;
        }

        body {
            background-image: url('/interior.jpeg'); /* Misma imagen de fondo */
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            align-items: center; /* Centrar verticalmente */
            justify-content: center;
        }

        /* TARJETA CENTRAL */
        .card-dark {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.7);
            border-radius: 8px;
            padding: 30px;
            width: 100%;
            max-width: 500px; /* Ancho máximo para que se vea elegante */
        }

        .header-title {
            color: white;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 5px;
            border-left: 4px solid var(--brand-green);
            padding-left: 15px;
        }

        /* FORMULARIOS OSCUROS */
        .form-label {
            color: #aaa;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .form-control-dark {
            background-color: rgba(0, 0, 0, 0.4);
            border: 1px solid #444;
            color: white;
            padding: 10px;
        }

            .form-control-dark:focus {
                background-color: rgba(0, 0, 0, 0.6);
                border-color: var(--brand-green);
                color: white;
                box-shadow: 0 0 0 0.2rem rgba(30, 111, 66, 0.25);
            }

            /* Input Readonly (grisáceo) */
            .form-control-dark[readonly] {
                background-color: rgba(255, 255, 255, 0.05);
                color: #888;
            }

        /* Input de Archivo personalizado */
        .form-control[type="file"] {
            background-color: rgba(0, 0, 0, 0.4);
            border: 1px dashed #555;
            color: #ccc;
        }

        /* BOTONES */
        .btn-confirm {
            background-color: var(--brand-green);
            color: white;
            font-weight: bold;
            border: none;
            padding: 10px;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.2s;
        }

            .btn-confirm:hover {
                background-color: var(--brand-green-hover);
                color: white;
            }

        .btn-cancel {
            color: #888;
            text-decoration: none;
            font-size: 0.9rem;
            display: block;
            text-align: center;
            margin-top: 15px;
            transition: 0.2s;
        }

            .btn-cancel:hover {
                color: white;
            }

        .contract-badge {
            background-color: #333;
            color: white;
            padding: 5px 10px;
            border-radius: 4px;
            font-family: monospace;
            border: 1px solid #555;
        }
    </style>
</head>
<body>

    <div class="card-dark">
        <div class="mb-4">
            <h2 class="header-title">Subir Diseño</h2>
            <p class="text-secondary small ms-3">Adjunta la prueba de diseño para este contrato.</p>
        </div>

        <div class="mb-3 p-3" style="background-color: rgba(255,255,255,0.03); border-radius: 6px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small fw-bold">COLEGIO:</span>
                <span class="fw-bold text-white">@Model.NombreColegio</span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-secondary small fw-bold">CONTRATO:</span>
                <span class="contract-badge">#@Model.Codigo</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.NombreProducto))
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary">
                    <span class="text-secondary small fw-bold">PRODUCTO:</span>
                    <span class="text-info small">@Model.NombreProducto</span>
                </div>
            }
        </div>

        <form asp-action="Cargar" method="post" enctype="multipart/form-data">

            <input type="hidden" name="codigoContrato" value="@Model.Codigo" />

            <div class="mb-4">
                <label class="form-label"><i class="bi bi-image me-1"></i> Seleccionar Imagen (JPG/PNG)</label>
                <input type="file" name="archivo" class="form-control form-control-dark" accept="image/*" required />
                <div class="form-text text-secondary small mt-2">
                    <i class="bi bi-info-circle"></i> Asegúrese de que el diseño sea el final aprobado.
                </div>
            </div>

            <button type="submit" class="btn-confirm">
                <i class="bi bi-cloud-upload me-2"></i> CONFIRMAR CARGA
            </button>

            <a asp-action="Index" class="btn-cancel">Cancelar y Volver</a>
        </form>
    </div>

</body>
</html>