@model IEnumerable<InCollege.Dominio.Modelos.Contrato>

@{
    ViewData["Title"] = "Gestión de Diseños";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Diseños Pendientes - InCollege</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --brand-green: #1e6f42;
            --brand-green-hover: #145230;
            --card-bg: rgba(18, 18, 18, 0.95);
            --text-silver: #cccccc;
        }

        body {
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        .dashboard-wrapper {
            width: 90%;
            max-width: 1400px;
            margin: 0 auto;
            padding-top: 20px;
            padding-bottom: 40px;
        }

        .card-dark {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
            border-radius: 8px;
            padding: 20px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 15px 20px;
        }

        .main-title {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 0;
            text-transform: uppercase;
        }

        .table-compact {
            width: 100%;
            border-collapse: collapse;
        }

            .table-compact th {
                font-size: 0.75rem;
                padding: 12px 15px;
                background-color: rgba(30, 30, 30, 1);
                color: #aaa;
                border-bottom: 2px solid #444;
                text-align: left;
                text-transform: uppercase;
            }

            .table-compact td {
                font-size: 0.9rem;
                padding: 12px 15px;
                border-bottom: 1px solid #333;
                color: white;
                vertical-align: middle;
            }

        .btn-upload {
            background-color: var(--brand-green);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: bold;
            text-decoration: none;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-upload:hover {
                background-color: var(--brand-green-hover);
                color: white;
                transform: translateY(-2px);
            }

        .btn-back {
            color: #aaa;
            text-decoration: none;
            border: 1px solid #555;
            padding: 8px 15px;
            border-radius: 4px;
            transition: 0.2s;
        }

            .btn-back:hover {
                background-color: #333;
                color: white;
                border-color: white;
            }

        /* ESTILOS DEL BUSCADOR */
        .search-input {
            background-color: rgba(0, 0, 0, 0.3);
            border: 1px solid #444;
            color: white;
        }

            .search-input:focus {
                background-color: rgba(0, 0, 0, 0.5);
                border-color: var(--brand-green);
                color: white;
                box-shadow: none;
            }

            .search-input::placeholder {
                color: #777;
            }
    </style>
</head>
<body>

    <div class="dashboard-wrapper">

        <div class="card-dark top-header">
            <div style="border-left: 5px solid var(--brand-green); padding-left: 15px;">
                <h1 class="main-title">DISEÑOS PENDIENTES</h1>
                <p class="m-0 text-secondary small">Listado de contratos que esperan la carga de imagen.</p>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-left me-2"></i>VOLVER AL PANEL
                </a>
            </div>
        </div>

        <div class="card-dark mb-4 py-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="busqueda" class="form-control search-input"
                               placeholder="Buscar por Colegio o N° Contrato..."
                               value="@ViewData["BusquedaActual"]">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-light w-100">BUSCAR</button>
                </div>
            </form>
        </div>

        <div class="card-dark">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-secondary">
                    @if (ViewData["BusquedaActual"] != null)
                    {
                        <i class="bi bi-search fs-1 d-block mb-3 opacity-50"></i>
                        <h4>Sin resultados</h4>
                        <p>No se encontraron contratos para "<strong>@ViewData["BusquedaActual"]</strong>"</p>
                        <a asp-action="Index" class="text-success">Ver todos</a>
                    }
                    else
                    {
                        <i class="bi bi-check-circle fs-1 d-block mb-3 opacity-50"></i>
                        <h4>¡Todo al día!</h4>
                        <p>No hay contratos pendientes de diseño en este momento.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-compact">
                        <thead>
                            <tr>
                                <th>CÓDIGO</th>
                                <th>COLEGIO</th>
                                <th>PRODUCTO</th>
                                <th>FECHA INGRESO</th>
                                <th class="text-end">ACCIÓN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-dark border border-secondary font-monospace">
                                            #@item.Codigo
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.NombreColegio</div>
                                        @if (item.EstadoDiseno == InCollege.Dominio.Modelos.EstadoDiseno.Aprobado)
                                        {
                                            <span class="badge bg-success" style="font-size: 0.65rem;">DISEÑO LISTO</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary" style="font-size: 0.65rem;">PENDIENTE</span>
                                        }
                                    </td>
                                    <td class="text-info">
                                        @if (!string.IsNullOrEmpty(item.NombreProducto))
                                        {
                                            @item.NombreProducto
                                        }
                                        else
                                        {

                                            <span>--</span>
                                        }
                                    </td>
                                    <td class="text-secondary">@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">

                                        @if (item.EstadoDiseno == InCollege.Dominio.Modelos.EstadoDiseno.Aprobado && !string.IsNullOrEmpty(item.UrlImagenDiseno))
                                        {
                                            // OPCIÓN 1: YA TIENE DISEÑO -> BOTÓN PARA VER
                                            <a href="@item.UrlImagenDiseno" target="_blank" class="btn btn-outline-info btn-sm fw-bold" style="border: 1px solid #0dcaf0;">
                                                <i class="bi bi-eye"></i> VER IMAGEN
                                            </a>

                                            // Botón chiquito para cambiar la foto si se equivocaron
                                            <a asp-action="Cargar" asp-route-id="@item.Codigo" class="btn btn-dark btn-sm border-secondary ms-1" title="Cambiar imagen">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            // OPCIÓN 2: NO TIENE DISEÑO -> BOTÓN PARA SUBIR
                                            <a asp-action="Cargar" asp-route-id="@item.Codigo" class="btn-upload">
                                                <i class="bi bi-cloud-upload"></i> SUBIR DISEÑO
                                            </a>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

</body>
</html>