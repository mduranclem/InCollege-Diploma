@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recuperar - InCollege</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #000 url('/interior.jpeg') no-repeat center center fixed;
            background-size: cover;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card-auth {
            background: rgba(0,0,0,0.85);
            padding: 40px;
            border-radius: 15px;
            width: 100%;
            max-width: 450px;
            border: 1px solid #444;
        }

        .form-control {
            background: rgba(255,255,255,0.1);
            border: 1px solid #555;
            color: white;
        }

            .form-control:focus {
                background: rgba(255,255,255,0.2);
                color: white;
                border-color: #1e6f42;
                box-shadow: none;
            }

        .btn-green {
            background-color: #1e6f42;
            color: white;
            width: 100%;
            padding: 10px;
            border: none;
            font-weight: bold;
            border-radius: 5px;
        }

            .btn-green:hover {
                background-color: #145230;
            }
    </style>
</head>
<body>
    <div class="card-auth text-center">
        <h3 class="mb-3 fw-bold">¿OLVIDASTE TU CLAVE?</h3>
        <p class="text-secondary small mb-4">Ingresa tu correo y te enviaremos un enlace de recuperación.</p>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-success">@ViewBag.Mensaje</div>
            <a href="/Home/Index" class="text-white text-decoration-none small">Volver al Login</a>
        }
        else
        {
            <form action="OlvidePassword" method="post">
                <div class="mb-3">
                    <input type="email" name="email" class="form-control" placeholder="Tu Email Corporativo" required />
                </div>
                <button type="submit" class="btn-green">ENVIAR ENLACE</button>
            </form>
            <div class="mt-3">
                <a href="/Home/Index" class="text-secondary text-decoration-none small">Cancelar y volver</a>
            </div>
        }
    </div>
</body>
</html>