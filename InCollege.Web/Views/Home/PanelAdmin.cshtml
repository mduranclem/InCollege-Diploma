@using InCollege.Dominio.Modelos
@using Microsoft.AspNetCore.Http
@model IEnumerable<Contrato>

@{
    ViewData["Title"] = "Panel de Control";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Control - InCollege</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* MIS VARIABLES */
        :root {
            --brand-green: #1e6f42;
            --brand-green-hover: #145230;
            --card-bg: rgba(18, 18, 18, 0.95);
            --text-silver: #cccccc;
        }

        body {
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* MI CONTENEDOR PRINCIPAL */
        .dashboard-wrapper {
            width: 90%;
            max-width: 1400px;
            margin: 0 auto;
            padding-top: 20px;
            padding-bottom: 40px;
        }

        /* MI DISEÑO DE TARJETAS OSCURAS */
        .card-dark {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
            border-radius: 8px;
        }

        /* MI HEADER SUPERIOR */
        .top-header {
            padding: 12px 20px;
            margin-bottom: 20px;
        }

        .main-title {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 0;
            text-transform: uppercase;
        }

        .sub-title {
            font-size: 0.85rem;
            color: #999;
            margin: 0;
        }

        .btn-new-contract {
            background-color: var(--brand-green);
            color: white;
            border: none;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 15px;
            border-radius: 4px;
            text-transform: uppercase;
            text-decoration: none;
            display: inline-block;
        }

            .btn-new-contract:hover {
                background-color: var(--brand-green-hover);
                color: white;
            }

        /* MIS INDICADORES (KPIs) */
        .kpi-box {
            background-color: rgba(25, 25, 25, 0.95);
            border: 1px solid #444;
            border-left: 4px solid var(--brand-green);
            padding: 10px 15px;
            height: 100%;
            min-height: 80px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            transition: 0.2s;
        }

            .kpi-box:hover {
                transform: translateY(-2px);
                border-color: #777;
            }

        .kpi-title {
            font-size: 0.7rem;
            font-weight: 700;
            color: #aaa;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        .kpi-number {
            font-size: 1.8rem;
            font-weight: 800;
            line-height: 1;
            color: white;
        }

        .kpi-icon {
            position: absolute;
            right: 10px;
            top: 10px;
            font-size: 2rem;
            opacity: 0.15;
        }

        /* MIS BOTONES DEL MENÚ DE ACCIONES */
        .section-header {
            padding: 10px 15px;
            border-bottom: 1px solid #333;
        }

        .section-title {
            font-size: 0.9rem;
            margin: 0;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .action-block {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid #444;
            color: #eee;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 10px 15px;
            border-radius: 6px;
            transition: 0.2s;
            height: 70px;
        }

            .action-block:hover {
                background-color: #222;
                border-color: var(--brand-green);
                transform: translateY(-2px);
                color: white;
            }

            .action-block i {
                font-size: 1.4rem;
                color: var(--brand-green);
                margin-right: 12px;
                min-width: 25px;
                text-align: center;
            }

        .action-text {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.1;
            color: white;
        }

        .action-block.blue:hover {
            border-color: #0d6efd;
        }

        .action-block.blue i {
            color: #0d6efd;
        }

        /* MIS ESTILOS DE LA TABLA */
        .table-wrapper-dark {
            background-color: var(--card-bg);
        }

        .table-compact {
            width: 100%;
            border-collapse: collapse;
        }

            .table-compact th {
                font-size: 0.75rem;
                padding: 8px 15px;
                background-color: rgba(30, 30, 30, 1);
                color: #aaa;
                border-bottom: 2px solid #444;
                text-align: left;
            }

            .table-compact td {
                font-size: 0.85rem;
                padding: 8px 15px;
                border-bottom: 1px solid #333;
                color: white;
                vertical-align: middle;
            }

        .badge-custom {
            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 3px;
        }

        .action-icon-btn {
            background-color: transparent;
            border: 1px solid #555;
            color: #888;
            padding: 4px 8px;
            border-radius: 4px;
            transition: 0.3s;
            margin-left: 5px;
            font-size: 1rem;
        }

        .btn-edit:hover {
            border-color: #ffc107;
            color: #ffc107;
            background-color: rgba(255, 193, 7, 0.1);
        }

        .btn-delete:hover {
            border-color: #dc3545;
            color: #dc3545;
            background-color: rgba(220, 53, 69, 0.1);
        }

        .btn-detail {
            font-size: 0.75rem;
            padding: 4px 10px;
            font-weight: bold;
            border-radius: 4px;
            color: #ddd;
            border: 1px solid #555;
            text-decoration: none;
        }

            .btn-detail:hover {
                color: white;
                border-color: white;
                background-color: #333;
            }
    </style>
</head>
<body>

    <div class="dashboard-wrapper">

        <div class="d-flex justify-content-between align-items-center top-header card-dark">
            <div style="border-left: 5px solid #198754; padding-left: 15px;">
                <h1 class="main-title">PORTAL DE ADMIN</h1>
                <p class="sub-title">Bienvenido al sistema.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Contratos" asp-action="Crear" class="btn-new-contract shadow">
                    <i class="bi bi-plus-lg me-1"></i> NUEVO CONTRATO
                </a>

                <a asp-controller="Auditoria" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-flex align-items-center text-decoration-none" title="Ver Auditoría">
                    <i class="bi bi-shield-lock fs-5"></i>
                </a>

                <a asp-controller="Home" asp-action="CerrarSesion" class="btn btn-outline-danger btn-sm px-3 d-flex align-items-center text-decoration-none" title="Cerrar Sesión">
                    <span class="me-2 fw-bold">SALIR</span> <i class="bi bi-box-arrow-right fs-5"></i>
                </a>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-5 g-3 mb-4">
            <div class="col">
                <div class="kpi-box">
                    <div class="kpi-title">ACTIVOS</div>
                    <div class="kpi-number">@ViewBag.TotalContratos</div>
                    <i class="bi bi-file-earmark-text kpi-icon text-success"></i>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box" style="border-left-color: #ffc107;">
                    <div class="kpi-title">PRODUCCIÓN</div>
                    <div class="kpi-number text-warning">@ViewBag.EnProduccion</div>
                    <i class="bi bi-gear-wide-connected kpi-icon text-warning"></i>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box" style="background-color: rgba(60, 10, 10, 0.8); border-color: #800; border-left-color: #dc3545;">
                    <div class="kpi-title" style="color: #ffaaaa;">PERDIDOS</div>
                    <div class="kpi-number text-danger">@ViewBag.ContratosPerdidos</div>
                    <i class="bi bi-x-circle kpi-icon text-danger"></i>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box" style="border-left-color: #dc3545;">
                    <div class="kpi-title">MORA</div>
                    <div class="kpi-number text-danger">0</div>
                    <i class="bi bi-exclamation-triangle kpi-icon text-danger"></i>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box" style="border-left-color: #fff;">
                    <div class="kpi-title">SOLICITUDES</div>
                    <div class="kpi-number text-white">@ViewBag.PendientesAprobacion</div>
                    <a asp-controller="Usuarios" asp-action="Gestionar" class="btn btn-outline-light btn-sm mt-1 w-100 py-0" style="font-size:0.7rem">REVISAR</a>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card-dark h-100">
                    <div class="section-header">
                        <h3 class="section-title text-success"><i class="bi bi-pencil-square me-2"></i>CARGA Y REGISTROS</h3>
                    </div>
                    <div class="p-3">
                        <div class="row g-3">
                            <div class="col-6">
                                <a asp-controller="Colegios" asp-action="Crear" class="action-block">
                                    <i class="bi bi-building-add"></i><span class="action-text">REGISTRAR<br>COLEGIO</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Usuarios" asp-action="Gestionar" class="action-block">
                                    <i class="bi bi-people-fill"></i><span class="action-text">GESTIONAR<br>STAFF</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Pagos" asp-action="Index" class="action-block">
                                    <i class="bi bi-cash-coin"></i><span class="action-text">REGISTRAR<br>PAGOS</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Talleres" asp-action="Index" class="action-block">
                                    <i class="bi bi-scissors"></i><span class="action-text">GESTIÓN<br>TALLERES</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-dark h-100">
                    <div class="section-header">
                        <h3 class="section-title text-primary" style="color: #6ea8fe !important;"><i class="bi bi-search me-2"></i>CONSULTAS</h3>
                    </div>
                    <div class="p-3">
                        <div class="row g-3">
                            <div class="col-6">
                                <a asp-controller="Colegios" asp-action="Index" class="action-block blue">
                                    <i class="bi bi-buildings"></i><span class="action-text">VER<br>ESCUELAS</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Contratos" asp-action="AsignarVendedor" class="action-block blue">
                                    <i class="bi bi-person-check-fill"></i>
                                    <span class="action-text">REASIGNAR<br>VENDEDOR</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Contratos" asp-action="Index" class="action-block blue">
                                    <i class="bi bi-table"></i><span class="action-text">VER<br>CONTRATOS</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Disenos" asp-action="Index" class="action-block blue">
                                    <i class="bi bi-images"></i><span class="action-text">DISEÑOS<br></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">

            <div class="col-lg-4">
                <div class="card-dark h-100 p-3">
                    <h5 class="text-white text-center mb-3" style="font-size: 0.9rem; font-weight: bold; letter-spacing: 1px;">ESTADO DE CONTRATOS</h5>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="graficoTorta"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card-dark h-100 p-3">
                    <h5 class="text-white text-center mb-3" style="font-size: 0.9rem; font-weight: bold; letter-spacing: 1px;">AVANCE DE PRODUCCIÓN</h5>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="graficoProduccion"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card-dark h-100 p-3">
                    <h5 class="text-white text-center mb-3" style="font-size: 0.9rem; font-weight: bold; letter-spacing: 1px;">RENDIMIENTO VENDEDORES</h5>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="graficoBarras"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <div class="card-dark mb-4">
            <div class="section-header">
                <h3 class="section-title text-white">ÚLTIMOS CONTRATOS</h3>
            </div>
            <div class="table-wrapper-dark table-responsive">
                <table class="table-compact">
                    <thead>
                        <tr>
                            <th class="ps-4">N°</th>
                            <th>COLEGIO</th>
                            <th>VENDEDOR</th>
                            <th>EGRESADOS</th>
                            <th>ESTADO</th>
                            <th class="text-end pe-4">ACCIÓN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count() == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-silver">
                                    <i class="bi bi-inbox fs-4 d-block mb-2 opacity-50"></i>
                                    <span style="font-size:0.9rem">No hay contratos cargados aún.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @if (item.Codigo > 0)
                                        {
                                            <span class="badge bg-dark border border-secondary text-white font-monospace">#@item.Codigo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border border-secondary">---</span>
                                        }
                                    </td>

                                    <td class="fw-bold text-white">@item.NombreColegio</td>

                                    <td class="text-silver">@item.VendedorAsignado</td>

                                    <td class="text-silver">@item.CantidadEgresados u.</td>

                                    <td>
                                        @if (item.Estado == "En Producción")
                                        {
                                            <span class="badge bg-warning text-dark badge-custom">
                                                @(item.NombreTaller ?? "En Taller") (@(item.EtapaProduccion ?? "Proceso"))
                                            </span>
                                        }
                                        else if (item.Estado == "Entregado")
                                        {
                                            <span class="badge bg-success badge-custom">Entregado</span>
                                        }
                                        else if (item.Estado == "Perdido")
                                        {
                                            <span class="badge bg-danger badge-custom">Perdido</span>
                                        }
                                        else if (item.Estado == "Firmado")
                                        {
                                            <span class="badge bg-success badge-custom">Firmado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary badge-custom">@item.Estado</span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (item.Estado == "Presupuesto")
                                        {
                                            <form asp-controller="Contratos" asp-action="Firmar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-success btn-sm me-1 badge-custom" title="Firmar (Aprobar)">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>

                                            <form asp-controller="Contratos" asp-action="Cancelar" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Seguro que deseas marcar este contrato como PERDIDO?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm badge-custom" title="Marcar como Perdido">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            @if (item.Estado == "Firmado" || item.Estado == "En Producción")
                                            {
                                                <button type="button" class="btn btn-outline-warning btn-sm action-icon-btn me-1"
                                                        data-bs-toggle="modal" data-bs-target="#modalTaller-@item.Id" title="Asignar a Taller">
                                                    <i class="bi bi-gear-wide-connected"></i>
                                                </button>
                                            }

                                            <a asp-controller="Contratos" asp-action="Detalle" asp-route-id="@item.Id" class="btn-detail">DETALLE</a>
                                        }

                                        <a asp-controller="Contratos" asp-action="Editar" asp-route-id="@item.Id" class="action-icon-btn btn-edit" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    @foreach (var item in Model)
    {
        @if (item.Estado == "Firmado" || item.Estado == "En Producción")
        {
            <div class="modal fade" id="modalTaller-@item.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="background-color: #1a1a1a; border: 1px solid #444; color: white;">

                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title fw-bold text-warning">
                                <i class="bi bi-scissors me-2"></i>Producción: #@item.Codigo
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <form asp-controller="Contratos" asp-action="AsignarTaller" method="post">
                            <div class="modal-body">
                                <input type="hidden" name="contratoId" value="@item.Id" />

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold">SELECCIONAR TALLER DESTINO</label>
                                    <select name="tallerId" class="form-select bg-dark text-white border-secondary" required>
                                        <option value="">-- Elegir Taller --</option>
                                        @if (ViewBag.ListaTalleres != null)
                                        {
                                            foreach (var t in ViewBag.ListaTalleres as List<InCollege.Dominio.Modelos.Taller>)
                                            {
                                                bool seleccionado = item.TallerAsignadoId == t.Id;
                                                if (seleccionado)
                                                {
                                                    <option value="@t.Id" selected>@t.Nombre ➡ (@t.Especialidad)</option>
                                                }
                                                else
                                                {
                                                    <option value="@t.Id">@t.Nombre ➡ (@t.Especialidad)</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <div class="form-text text-secondary mt-2" style="font-size: 0.8rem;">
                                        <i class="bi bi-info-circle me-1"></i> La etapa se asignará automáticamente según la especialidad del taller.
                                    </div>
                                </div>

                                @if (item.TallerAsignadoId != null)
                                {
                                    <div class="alert alert-dark border border-warning text-warning p-2 small m-0">
                                        <i class="bi bi-info-circle me-1"></i> Actualmente en: <strong>@item.NombreTaller</strong> (@item.EtapaProduccion)
                                    </div>
                                }

                            </div>
                            <div class="modal-footer border-top border-secondary">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-warning btn-sm fw-bold">ENVIAR A PRODUCCIÓN</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Configuro colores generales para que encajen con mi tema oscuro
        Chart.defaults.color = '#aaaaaa';
        Chart.defaults.font.family = "'Segoe UI', sans-serif";

        // --- 1. MI GRÁFICO DE TORTA (ESTADO DE CONTRATOS) ---
        const ctxTorta = document.getElementById('graficoTorta').getContext('2d');
        const graficoTorta = new Chart(ctxTorta, {
            type: 'doughnut',
            data: {
                labels: ['Firmados/Activos', 'Perdidos', 'En Presupuesto'],
                datasets: [{
                    // Los datos los traigo inyectados directo del Controlador por ViewBag
                    data: [@ViewBag.CantFirmados, @ViewBag.CantPerdidos, @ViewBag.CantPresupuestos],
                    backgroundColor: [
                        '#198754', // Verde oscuro para confirmados
                        '#dc3545', // Rojo para perdidos
                        '#6c757d'  // Gris para en evaluación
                    ],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // --- 2. MI NUEVO GRÁFICO DE TORTA (AVANCE DE PRODUCCIÓN) ---
        const ctxProduccion = document.getElementById('graficoProduccion').getContext('2d');
        const graficoProduccion = new Chart(ctxProduccion, {
            type: 'doughnut',
            data: {
                labels: ['En Espera', 'En Producción', 'Entregados'],
                datasets: [{
                    // Obtengo las cantidades que calculé en mi controlador
                    data: [@ViewBag.CantSoloFirmados, @ViewBag.CantEnProduccion, @ViewBag.CantEntregados],
                    backgroundColor: [
                        '#ffc107', // Amarillo: Esperando entrar a taller
                        '#0dcaf0', // Celeste: Ya está en producción
                        '#198754'  //  Verde institucional para Entregados
                    ],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // --- 3. MI GRÁFICO DE BARRAS (RENDIMIENTO DE VENDEDORES) ---
        // Convierto mis listas de C# a arrays de JavaScript para el gráfico
        const nombresVendedores = @Html.Raw(Json.Serialize(ViewBag.NombresVendedores));
        const cantidadesVentas = @Html.Raw(Json.Serialize(ViewBag.CantidadesVentas));

        const ctxBarras = document.getElementById('graficoBarras').getContext('2d');
        const graficoBarras = new Chart(ctxBarras, {
            type: 'bar',
            data: {
                labels: nombresVendedores,
                datasets: [{
                    label: 'Contratos Cerrados',
                    data: cantidadesVentas,
