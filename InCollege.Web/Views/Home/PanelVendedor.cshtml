@using InCollege.Dominio.Modelos
@model List<Contrato>

@{
    ViewData["Title"] = "Panel Vendedor";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Portal de Ventas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --brand-green: #1e6f42;
            --brand-green-hover: #145230;
            --card-bg: rgba(18, 18, 18, 0.95);
        }

        body {
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        .dashboard-wrapper {
            width: 95%;
            max-width: 1400px;
            margin: 0 auto;
            padding-top: 40px;
        }

        .card-dark {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        }

        /* HEADER */
        .welcome-title {
            font-size: 2.5rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
            border-left: 8px solid var(--brand-green);
            padding-left: 20px;
        }

        .welcome-sub {
            color: #aaa;
            font-size: 1.1rem;
            margin-left: 28px;
        }

        /* BOTONES GRANDES */
        .btn-action-card {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            background-color: rgba(255,255,255,0.03);
            border: 2px solid #444;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            height: 180px;
            transition: 0.3s;
        }

            .btn-action-card:hover {
                background-color: #222;
                border-color: var(--brand-green);
                transform: translateY(-5px);
                color: white;
            }

            .btn-action-card i {
                font-size: 3.5rem;
                margin-bottom: 15px;
                color: var(--brand-green);
            }

        .btn-text {
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .btn-logout {
            border: 1px solid #dc3545;
            color: #dc3545;
            text-decoration: none;
            padding: 10px 25px;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.2s;
            display: flex;
            align-items: center;
        }

            .btn-logout:hover {
                background-color: #dc3545;
                color: white;
            }

        /* TABLA */
        .table-custom th {
            color: #888;
            border-bottom: 2px solid #444;
            padding: 15px;
            text-align: left;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .table-custom td {
            border-bottom: 1px solid #333;
            padding: 15px;
            color: white;
            vertical-align: middle;
            font-size: 1.1rem;
        }

        .badge-custom {
            font-size: 0.8rem;
            padding: 6px 12px;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <div class="dashboard-wrapper">

        <div class="d-flex justify-content-between align-items-center mb-5 card-dark p-4">
            <div>
                <h1 class="welcome-title">PORTAL DE VENTAS</h1>
                <p class="welcome-sub">Bienvenido al sistema.</p>
            </div>
            <div>
                <a href="/Home/Index" class="btn-logout"><i class="bi bi-box-arrow-right me-2 fs-5"></i> SALIR</a>
            </div>
        </div>

        <div class="row g-4 mb-5">

            <div class="col-md-4">
                <a href="/Contratos/Crear" class="btn-action-card">
                    <i class="bi bi-file-earmark-plus"></i>
                    <span class="btn-text">Nuevo Contrato</span>
                </a>
            </div>

            <div class="col-md-4">
                <a href="/Contratos/Index" class="btn-action-card">
                    <i class="bi bi-table"></i>
                    <span class="btn-text">Ver Contratos</span>
                </a>
            </div>

            <div class="col-md-4">
                <a href="/Colegios/Index" class="btn-action-card">
                    <i class="bi bi-buildings"></i>
                    <span class="btn-text">Ver Escuelas</span>
                </a>
            </div>

        </div>

        <div class="card-dark">
            <h4 class="text-white mb-4 fw-bold border-bottom border-secondary pb-3">MIS ÚLTIMOS MOVIMIENTOS</h4>
            <div class="table-responsive">
                <table class="w-100 table-custom">
                    <thead>
                        <tr>
                            <th class="ps-4">N°</th>
                            <th>COLEGIO</th>
                            <th>PACK / DISEÑO</th>
                            <th>ESTADO</th>
                            <th class="text-end pe-4">ACCIÓN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center py-5 text-secondary">No hay contratos recientes.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-dark border border-secondary text-white font-monospace">@item.Codigo</span>
                                    </td>
                                    <td class="fw-bold">@item.NombreColegio</td>
                                    <td class="text-info">@item.NombreProducto</td>
                                    <td>
                                        @if (item.Estado == "Firmado")
                                        {
                                            <span class="badge bg-primary badge-custom">ACTIVO</span>
                                        }
                                        else if (item.Estado == "Perdido")
                                        {

                                            <span class="badge bg-dark text-secondary badge-custom border border-secondary">PERDIDO</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary badge-custom">PRESUPUESTO</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/Contratos/Detalle/@item.Id" class="btn btn-outline-light btn-sm px-3 fw-bold">VER</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>