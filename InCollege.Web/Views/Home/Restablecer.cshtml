@{
    ViewData["Title"] = "Nueva Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Nueva Clave - InCollege</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #000 url('/interior.jpeg') no-repeat center center fixed;
            background-size: cover;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card-auth {
            background: rgba(0,0,0,0.85);
            padding: 40px;
            border-radius: 15px;
            width: 100%;
            max-width: 450px;
            border: 1px solid #444;
        }

        .form-control {
            background: rgba(255,255,255,0.1);
            border: 1px solid #555;
            color: white;
        }

            .form-control:focus {
                background: rgba(255,255,255,0.2);
                color: white;
                border-color: #1e6f42;
                box-shadow: none;
            }

        .btn-green {
            background-color: #1e6f42;
            color: white;
            width: 100%;
            padding: 10px;
            border: none;
            font-weight: bold;
            border-radius: 5px;
        }

            .btn-green:hover {
                background-color: #145230;
            }
    </style>
</head>
<body>
    <div class="card-auth text-center">
        <h3 class="mb-4 fw-bold text-uppercase" style="border-left: 5px solid #1e6f42;">Nueva Contraseña</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form action="Restablecer" method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3 text-start">
                <label class="small text-secondary">Nueva Contraseña</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="mb-4 text-start">
                <label class="small text-secondary">Confirmar Contraseña</label>
                <input type="password" name="confirmarPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn-green">GUARDAR CAMBIOS</button>
        </form>
    </div>
</body>
</html>