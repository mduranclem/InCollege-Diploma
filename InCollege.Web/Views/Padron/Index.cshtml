@using InCollege.Dominio.Modelos
@model List<Estudiante>

@{
    ViewData["Title"] = "Padrón de Alumnos";
    var contrato = ViewBag.Contrato as Contrato;
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Padrón - @contrato.NombreColegio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #000;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-container {
            padding-top: 30px;
            padding-bottom: 50px;
            width: 95%;
            max-width: 1600px;
            margin: 0 auto;
        }

        .card-dark {
            background-color: rgba(18, 18, 18, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            height: 100%;
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .page-subtitle {
            color: #aaa;
            font-size: 1.1rem;
        }

        .contract-info {
            color: #1e6f42;
            font-weight: bold;
            border: 1px solid #1e6f42;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-custom th {
                text-align: left;
                padding: 15px;
                border-bottom: 2px solid #444;
                color: #888;
                text-transform: uppercase;
                font-size: 0.85rem;
            }

            .table-custom td {
                padding: 15px;
                border-bottom: 1px solid #333;
                font-size: 1.1rem;
                vertical-align: middle;
            }

            .table-custom tr:hover {
                background-color: rgba(255,255,255,0.05);
            }

        .btn-back {
            color: #ccc;
            text-decoration: none;
            font-weight: 600;
        }

            .btn-back:hover {
                color: white;
            }

        /* Inputs de Talle */
        .input-talle {
            background-color: transparent;
            border: 1px solid transparent;
            color: white;
            text-align: center;
            width: 100%;
            font-weight: bold;
            text-transform: uppercase;
        }

            .input-talle:focus {
                background-color: #333;
                border-color: #555;
                outline: none;
            }

            .input-talle::placeholder {
                color: #555;
            }
    </style>
</head>
<body>

    <div class="main-container">

        <div class="d-flex justify-content-between align-items-end mb-4 p-3 card-dark" style="height: auto;">
            <div>
                <h1 class="page-title">@contrato.NombreColegio</h1>
                <div class="d-flex align-items-center gap-3 mt-2">
                    <span class="badge bg-light text-dark fs-6 border border-secondary">CONTRATO #@contrato.Codigo</span>
                    <span class="page-subtitle">Gestión de Padrón</span>
                    <span class="contract-info">@contrato.NombreProducto</span>
                    <span class="contract-info text-white border-white">@contrato.CantidadEgresados Estudiantes Est.</span>
                </div>
            </div>
            <a href="/Contratos/Detalle/@contrato.Id" class="btn-back"><i class="bi bi-arrow-left me-2"></i> Volver al Contrato</a>
        </div>

        <div class="card-dark">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-white fw-bold m-0">ALUMNOS REGISTRADOS (@Model.Count)</h4>
                <button class="btn btn-outline-light btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir Lista</button>
            </div>

            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-people display-1 opacity-25"></i>
                    <p class="mt-3 fs-5">No hay alumnos cargados para este contrato.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>CÓDIGO ÚNICO</th>
                                <th>APELLIDO Y NOMBRE</th>
                                <th class="text-center" style="width: 100px;">TALLE<br><small class="text-secondary">ABRIGO</small></th>
                                <th class="text-center" style="width: 100px;">TALLE<br><small class="text-secondary">REMERA</small></th>
                                <th class="text-end">ESTADO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 1;
                            }
                            @foreach (var alumno in Model)
                            {
                                <tr>
                                    <td class="text-secondary">@i</td>

                                    <td style="font-family: monospace; color: #4ade80; font-size: 1.1rem; font-weight:bold;">
                                        @alumno.CodigoUnico
                                    </td>

                                    <td class="fw-bold text-white">@alumno.Apellido, @alumno.Nombre</td>

                                    <td class="p-0 border-bottom border-secondary">
                                        <form action="/Padron/ActualizarTalles" method="post">
                                            <input type="hidden" name="id" value="@alumno.Id" />
                                            <input type="hidden" name="talleRemera" value="@alumno.TalleRemera" /> <input type="text" name="talleAbrigo" value="@(alumno.TalleAbrigo == "-" ? "" : alumno.TalleAbrigo)"
                                                                                                                          class="input-talle text-warning" placeholder="-" onchange="this.form.submit()">
                                        </form>
                                    </td>

                                    <td class="p-0 border-bottom border-secondary">
                                        <form action="/Padron/ActualizarTalles" method="post">
                                            <input type="hidden" name="id" value="@alumno.Id" />
                                            <input type="hidden" name="talleAbrigo" value="@alumno.TalleAbrigo" />

                                            <input type="text" name="talleRemera" value="@(alumno.TalleRemera == "-" ? "" : alumno.TalleRemera)"
                                                   class="input-talle text-info" placeholder="-" onchange="this.form.submit()">
                                        </form>
                                    </td>

                                    <td class="text-end">
                                        @if (alumno.EstaAlDia)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success">AL DÍA</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger">DEUDA</span>
                                        }
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

</body>
</html>