@using InCollege.Dominio.Modelos
@model List<Estudiante>

@{
    ViewData["Title"] = "Matriz de Control";
    Layout = null;

    var contrato = ViewBag.Contrato as Contrato;

    // CORRECCIÓN CRÍTICA: Si ViewBag.Pagos es nulo, usamos una lista vacía para evitar el error.
    var listaPagos = (ViewBag.Pagos as List<Pago>) ?? new List<Pago>();

    decimal recargo = ViewBag.RecargoHoy ?? 0; // Protección también para el recargo
    decimal precioBase = contrato.MontoPorCuota;
    decimal precioActual = precioBase + recargo;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Control Cuotas - @contrato.NombreColegio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
        }

        .main-card {
            background-color: rgba(15,15,15,0.98);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 0 60px rgba(0,0,0,0.9);
            overflow-x: auto;
            padding-bottom: 20px;
        }

        .header-info {
            padding: 20px;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            left: 0;
        }

        .table-matrix {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .table-matrix th {
                background-color: #222;
                color: #aaa;
                padding: 15px;
                text-transform: uppercase;
                font-size: 0.8rem;
                border-bottom: 4px solid #1e6f42;
                border-right: 1px solid #333;
                text-align: center;
                min-width: 120px;
            }

            .table-matrix td {
                border-bottom: 1px solid #222;
                border-right: 1px solid #222;
                padding: 8px;
                text-align: center;
                vertical-align: middle;
            }

        .sticky-col {
            position: sticky;
            left: 0;
            z-index: 10;
            background-color: #181818;
            border-right: 2px solid #444;
            min-width: 300px;
            text-align: left !important;
            padding-left: 20px !important;
        }

        .table-matrix tr:hover td {
            background-color: rgba(255,255,255,0.03);
        }

        .table-matrix tr:hover .sticky-col {
            background-color: #222;
        }

        .status-paid {
            background-color: rgba(25, 135, 84, 0.2);
            border: 1px solid #198754;
            color: #4ade80;
            border-radius: 4px;
            padding: 8px;
            font-weight: bold;
            font-size: 0.8rem;
            display: block;
        }

        .btn-pay-cell {
            background-color: transparent;
            border: 1px solid #444;
            color: #666;
            width: 100%;
            padding: 8px;
            border-radius: 4px;
            transition: 0.2s;
            font-size: 0.9rem;
            font-weight: bold;
        }

            .btn-pay-cell:hover {
                background-color: rgba(255, 193, 7, 0.1);
                border-color: #ffc107;
                color: #ffc107;
            }

        .price-tag {
            font-size: 0.9rem;
            padding: 5px 10px;
            background: #111;
            border: 1px solid #444;
            border-radius: 4px;
            margin-right: 10px;
            color: #ccc;
        }

        .price-value {
            color: #4ade80;
            font-weight: bold;
        }

        .recargo-alert {
            color: #ffc107;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }

            100% {
                opacity: 1;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid" style="padding: 20px;">

        <div class="main-card">

            <div class="header-info">
                <div>
                    <h2 class="fw-bold m-0 text-white">@contrato.NombreColegio</h2>
                    <div class="mt-2 d-flex align-items-center">
                        <span class="price-tag">Valor Base: $@precioBase.ToString("N0")</span>

                        @if (recargo > 0)
                        {
                            <span class="price-tag recargo-alert" style="border-color: #ffc107;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Recargo Hoy: $@recargo.ToString("N0")
                            </span>
                        }

                        <span class="price-tag" style="border-color: #1e6f42;">
                            A COBRAR HOY: <span class="price-value">$@precioActual.ToString("N0")</span>
                        </span>
                    </div>
                </div>
                <a href="/Pagos/Index" class="btn btn-outline-secondary btn-sm px-3">VOLVER</a>
            </div>

            <table class="table-matrix">
                <thead>
                    <tr>
                        <th class="sticky-col">ALUMNO / CÓDIGO</th>
                        <th style="min-width:100px; border-bottom-color: #ffc107;">SEÑA</th>

                        @for (int c = 1; c <= contrato.CantidadCuotas; c++)
                        {
                            <th>CUOTA @c</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var est in Model)
                    {
                        <tr>
                            <td class="sticky-col">
                                <div class="text-white fw-bold">@est.Apellido, @est.Nombre</div>
                                <div style="font-family: monospace; color: #555; font-size: 0.8rem;">@est.CodigoUnico</div>
                            </td>

                            @{
                                bool senaPaga = listaPagos.Any(p => p.EstudianteId == est.Id && (p.Concepto.Contains("Seña") || p.NumeroCuota == 0));
                            }
                            <td>
                                @if (senaPaga)
                                {
                                    <span class="status-paid" style="border-color: #ffc107; color: #ffc107; background-color: rgba(255,193,7,0.1);"><i class="bi bi-check-lg"></i> OK</span>
                                }
                                else
                                {
                                    <form action="/Pagos/RegistrarPagoIndividual" method="post">
                                        <input type="hidden" name="contratoId" value="@contrato.Id" />
                                        <input type="hidden" name="estudianteId" value="@est.Id" />
                                        <input type="hidden" name="nroCuota" value="0" /> <input type="hidden" name="monto" value="@contrato.MontoSeña" />
                                        <input type="hidden" name="medio" value="Chequera" />

                                        <button type="submit" class="btn-pay-cell" style="color: #ffc107; border-color: #ffc107;">
                                            $@contrato.MontoSeña.ToString("N0")
                                        </button>
                                    </form>
                                }
                            </td>

                            @for (int c = 1; c <= contrato.CantidadCuotas; c++)
                            {
                                var pagoHecho = listaPagos.FirstOrDefault(p => p.EstudianteId == est.Id && p.NumeroCuota == c);

                                <td>
                                    @if (pagoHecho != null)
                                    {
                                        <span class="status-paid" title="Pagado el @pagoHecho.FechaPago.ToShortDateString()">
                                            <i class="bi bi-check-circle-fill"></i> PAGO
                                        </span>
                                    }
                                    else
                                    {
                                        <form action="/Pagos/RegistrarPagoIndividual" method="post">
                                            <input type="hidden" name="contratoId" value="@contrato.Id" />
                                            <input type="hidden" name="estudianteId" value="@est.Id" />
                                            <input type="hidden" name="nroCuota" value="@c" />
                                            <input type="hidden" name="monto" value="@precioActual" />
                                            <input type="hidden" name="medio" value="Chequera" />

                                            <button type="submit" class="btn-pay-cell">
                                                $@precioActual.ToString("N0")
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</body>
</html>