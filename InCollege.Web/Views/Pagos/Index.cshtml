@model IEnumerable<InCollege.Dominio.Modelos.Contrato>

@{
    ViewData["Title"] = "Caja - Selección";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 40px;
        }

        .card-dark {
            background-color: rgba(15,15,15,0.96);
            border: 1px solid #333;
            padding: 30px;
            border-radius: 12px;
            max-width: 1400px;
            margin: 0 auto;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }

        .btn-action {
            background-color: #1e6f42;
            color: white;
            text-decoration: none;
            padding: 10px 25px;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
        }

            .btn-action:hover {
                background-color: #145230;
                color: white;
                transform: translateY(-2px);
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            text-align: left;
            color: #888;
            border-bottom: 2px solid #444;
            padding: 15px;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
        }

        td {
            border-bottom: 1px solid #333;
            padding: 15px;
            vertical-align: middle;
            font-size: 1.1rem;
        }

        .btn-back {
            border: 1px solid #555;
            color: #ccc;
            text-decoration: none;
            padding: 8px 20px;
            border-radius: 6px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-back:hover {
                background-color: #222;
                color: white;
                border-color: #fff;
            }

        /* ESTILOS DEL BUSCADOR */
        .search-box {
            display: flex;
            gap: 10px;
            background-color: rgba(255,255,255,0.05);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #444;
            margin-bottom: 20px;
        }

        .input-search {
            background: transparent;
            border: none;
            color: white;
            font-size: 1.2rem;
            width: 100%;
            outline: none;
        }

            .input-search::placeholder {
                color: #666;
            }

        .btn-search {
            background-color: #0d6efd;
            border: none;
            color: white;
            padding: 0 25px;
            border-radius: 6px;
            font-weight: bold;
        }

            .btn-search:hover {
                background-color: #0b5ed7;
            }
    </style>
</head>
<body>

    <div class="card-dark">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold m-0 border-start border-5 border-success ps-3">GESTIÓN DE COBRANZAS</h2>
                <p class="text-secondary ms-4 mb-0 mt-1">Selecciona un contrato activo para imputar pagos</p>
            </div>
            <a href="/Home/PanelAdmin" class="btn-back">VOLVER AL PANEL</a>
        </div>

        <form action="/Pagos/Index" method="get">
            <div class="search-box">
                <i class="bi bi-search fs-3 text-secondary align-self-center ms-2"></i>
                <input type="text" name="busqueda" class="input-search ms-3"
                       placeholder="Buscar por Colegio, N° Contrato o Nombre del Alumno..."
                       value="@ViewData["BusquedaActual"]" autocomplete="off">

                @if (ViewData["BusquedaActual"] != null)
                {
                    <a href="/Pagos/Index" class="btn btn-outline-secondary d-flex align-items-center me-2">Limpiar</a>
                }
                <button type="submit" class="btn-search">BUSCAR</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="w-100">
                <thead>
                    <tr>
                        <th>CÓDIGO</th>
                        <th>INSTITUCIÓN</th>
                        <th>PRODUCTO</th>
                        <th>ALUMNOS</th>
                        <th class="text-end">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-search display-1 opacity-25"></i>
                                <p class="mt-3 fs-4">No se encontraron contratos.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-success font-monospace fw-bold">#@item.Codigo</td>
                                <td class="fw-bold fs-5 text-white">@item.NombreColegio</td>
                                <td class="text-info">@item.NombreProducto</td>
                                <td class="text-white">@item.CantidadEgresados Estudiantes</td>
                                <td class="text-end">
                                    <a href="/Pagos/EstadoSituacion/@item.Id" class="btn-action shadow-sm">
                                        <i class="bi bi-file-spreadsheet me-2"></i> VER CUENTA
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>