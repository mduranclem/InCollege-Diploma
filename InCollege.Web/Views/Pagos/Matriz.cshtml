@using InCollege.Dominio.Modelos
@model List<Estudiante>

@{
    ViewData["Title"] = "Matriz de Pagos";
    var contrato = ViewBag.Contrato as Contrato;
    var listaPagos = ViewBag.Pagos as List<Pago>;

    decimal recargo = ViewBag.RecargoHoy;
    decimal precioBase = contrato.MontoPorCuota;
    decimal precioConRecargo = precioBase + recargo;

    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Control Cuotas - @contrato.NombreColegio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
        }

        .main-card {
            background-color: rgba(15,15,15,0.98);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 0 50px rgba(0,0,0,0.8);
            overflow-x: auto; /* Permite scroll horizontal si hay muchas cuotas */
        }

        .table-matrix {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            /* Encabezados pegajosos para no perderse al bajar */
            .table-matrix th {
                background-color: #222;
                color: #aaa;
                padding: 15px;
                text-transform: uppercase;
                font-size: 0.8rem;
                border-bottom: 2px solid #1e6f42;
                position: sticky;
                top: 0;
                z-index: 10;
            }

        .sticky-col {
            position: sticky;
            left: 0;
            z-index: 11;
            background-color: #222;
            border-right: 2px solid #444;
        }

        .table-matrix td {
            padding: 10px;
            border-bottom: 1px solid #333;
            text-align: center;
            vertical-align: middle;
        }

        .table-matrix tr:hover td {
            background-color: rgba(255,255,255,0.05);
        }

        /* ESTADOS DE CELDA */
        .cell-paid {
            background-color: rgba(25, 135, 84, 0.2);
            border: 1px solid #198754;
            color: #4ade80;
            border-radius: 4px;
            padding: 8px;
            font-weight: bold;
            font-size: 0.9rem;
            display: block;
        }

        .btn-debt {
            background-color: transparent;
            border: 1px solid #555;
            color: #888;
            width: 100%;
            padding: 8px;
            border-radius: 4px;
            transition: 0.2s;
            font-size: 0.85rem;
        }

            .btn-debt:hover {
                border-color: #ffc107;
                color: #ffc107;
                background-color: rgba(255, 193, 7, 0.1);
            }

        .info-tag {
            font-size: 0.9rem;
            padding: 5px 10px;
            background: #111;
            border: 1px solid #444;
            border-radius: 4px;
            margin-right: 10px;
        }

        .text-price {
            color: #4ade80;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="main-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold m-0 text-white">@contrato.NombreColegio</h2>
                <div class="mt-2 text-secondary d-flex align-items-center">
                    <span class="info-tag">Cuota Base: $@precioBase.ToString("N0")</span>
                    <span class="info-tag">Día: @DateTime.Now.Day (Recargo: $@recargo.ToString("N0"))</span>
                    <span class="info-tag border-success text-success">A Cobrar Hoy: $@precioConRecargo.ToString("N0")</span>
                </div>
            </div>
            <a href="/Pagos/Index" class="btn btn-outline-light btn-sm">VOLVER</a>
        </div>

        <table class="table-matrix">
            <thead>
                <tr>
                    <th class="sticky-col text-start ps-4">ALUMNO</th>
                    @for (int c = 1; c <= contrato.CantidadCuotas; c++)
                    {
                        <th>CUOTA @c</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var est in Model)
                {
                    <tr>
                        <td class="sticky-col text-start ps-4 fw-bold text-white">@est.Apellido, @est.Nombre</td>

                        @for (int c = 1; c <= contrato.CantidadCuotas; c++)
                        {
                            // Buscamos si existe un pago para este alumno y esta cuota
                            var pagoHecho = listaPagos.FirstOrDefault(p => p.EstudianteId == est.Id && p.NumeroCuota == c);

                            <td>
                                @if (pagoHecho != null)
                                {
                                    // YA PAGÓ
                                    <span class="cell-paid">
                                        <i class="bi bi-check-circle-fill me-1"></i> PAGADO
                                    </span>
                                }
                                else
                                {
                                    // DEBE -> BOTÓN PARA COBRAR
                                    <form action="/Pagos/CobrarCuota" method="post">
                                        <input type="hidden" name="contratoId" value="@contrato.Id" />
                                        <input type="hidden" name="estudianteId" value="@est.Id" />
                                        <input type="hidden" name="nroCuota" value="@c" />

                                        <input type="hidden" name="monto" value="@precioConRecargo" />

                                        <button type="submit" class="btn-debt" title="Cobrar Cuota @c">
                                            $@precioConRecargo.ToString("N0")
                                        </button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>