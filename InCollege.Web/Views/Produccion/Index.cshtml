@model IEnumerable<InCollege.Dominio.Modelos.Contrato>

@{
    ViewData["Title"] = "Tablero de Producción";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Producción - InCollege</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 40px;
        }

        .card-dark {
            background-color: rgba(20, 20, 20, 0.95);
            border: 1px solid #444;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 0 40px rgba(0,0,0,0.8);
        }

        /* --- CORRECCIÓN DE LA TABLA --- */
        .table-prod {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            --bs-table-bg: transparent; /* TRUCO: Quita el fondo blanco de Bootstrap */
        }

            .table-prod thead th {
                background-color: #222 !important; /* Encabezado oscuro sólido */
                color: #aaa;
                border-bottom: 2px solid #ffc107; /* Línea amarilla */
                padding: 15px;
                text-transform: uppercase;
                font-size: 0.9rem;
            }

            .table-prod tbody tr {
                background-color: rgba(255, 255, 255, 0.05) !important; /* Fondo gris translúcido */
                transition: 0.3s;
                border-bottom: 1px solid #333;
            }

            .table-prod td {
                color: white !important; /* Texto forzado a blanco */
                padding: 20px 15px;
                vertical-align: middle;
            }

            .table-prod tbody tr:hover {
                background-color: rgba(255, 193, 7, 0.1) !important; /* Brillo amarillo al pasar el mouse */
            }

        .btn-bitacora {
            background-color: #ffc107;
            color: #000;
            font-weight: 800;
            padding: 8px 20px;
            border-radius: 6px;
            text-decoration: none;
            transition: 0.2s;
            display: inline-block;
        }

            .btn-bitacora:hover {
                background-color: #e0a800;
                transform: scale(1.05);
                color: black;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="card-dark">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold text-warning border-start border-5 border-warning ps-3 m-0">TABLERO DE PRODUCCIÓN</h2>
                    <p class="text-secondary ms-4 mb-0 small">Seguimiento en tiempo real de fabricación</p>
                </div>
                <a href="/Talleres/Index" class="btn btn-outline-secondary">VOLVER A TALLERES</a>
            </div>

            <div class="table-responsive">
                <table class="table table-prod">
                    <thead>
                        <tr>
                            <th>CONTRATO</th>
                            <th>COLEGIO</th>
                            <th>CANTIDAD</th>
                            <th>UBICACIÓN ACTUAL</th>
                            <th class="text-end">GESTIÓN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="bi bi-box-seam display-4 d-block mb-3 opacity-25"></i>
                                    No hay trabajos en curso actualmente.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-monospace text-warning fw-bold fs-5">#@item.Codigo</td>
                                    <td>
                                        <div class="fw-bold text-white fs-5">@item.NombreColegio</div>
                                        <div class="small text-secondary">@item.NombreProducto</div>
                                    </td>
                                    <td><span class="badge bg-dark border border-secondary">@item.CantidadEgresados prendas</span></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-geo-alt-fill text-danger me-2 fs-5"></i>
                                            <div>
                                                <div class="fw-bold">@(item.NombreTaller ?? "Sin Asignar")</div>
                                                <small class="text-secondary text-uppercase">@item.EtapaProduccion</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <a href="/Produccion/Seguimiento/@item.Id" class="btn-bitacora shadow">
                                            <i class="bi bi-journal-text me-2"></i>BITÁCORA
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>