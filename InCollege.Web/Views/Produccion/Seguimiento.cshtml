@model InCollege.Dominio.Modelos.Contrato
@using InCollege.Dominio.Modelos

@{
    ViewData["Title"] = "Seguimiento de Producción";
    Layout = null;
    var historial = ViewBag.Historial as List<MovimientoStock>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Producción #@Model.Codigo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 30px;
        }

        .main-card {
            background-color: rgba(20,20,20,0.96);
            border: 1px solid #444;
            border-radius: 12px;
            padding: 30px;
            min-height: 80vh;
            display: flex;
            gap: 30px;
        }

        /* Panel Izquierdo (Formulario) */
        .left-panel {
            flex: 1;
            border-right: 1px solid #444;
            padding-right: 30px;
        }

        /* Panel Derecho (Historial) */
        .right-panel {
            flex: 1.5;
            padding-left: 10px;
        }

        .timeline-item {
            border-left: 2px solid #1e6f42;
            padding-left: 20px;
            padding-bottom: 30px;
            position: relative;
        }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: -6px;
                top: 0;
                width: 10px;
                height: 10px;
                background: #1e6f42;
                border-radius: 50%;
            }

        .date-label {
            color: #888;
            font-size: 0.8rem;
            margin-bottom: 5px;
        }

        .msg-box {
            background: #1a1a1a;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #333;
        }

        .badge-avance {
            background: rgba(30, 111, 66, 0.2);
            color: #4ade80;
            border: 1px solid #1e6f42;
        }

        .badge-problema {
            background: rgba(220, 53, 69, 0.2);
            color: #ff6b6b;
            border: 1px solid #dc3545;
        }

        .badge-fin {
            background: rgba(13, 202, 240, 0.2);
            color: #0dcaf0;
            border: 1px solid #0dcaf0;
        }

        .form-control, .form-select {
            background: #111;
            border: 1px solid #555;
            color: white;
        }

            .form-control:focus {
                background: #222;
                color: white;
                border-color: #1e6f42;
                box-shadow: none;
            }
    </style>
</head>
<body>

    <div class="container main-card">

        <div class="left-panel">
            <a href="/Home/PanelAdmin" class="btn btn-outline-secondary btn-sm mb-4">← VOLVER</a>

            <h2 class="fw-bold">@Model.NombreColegio</h2>
            <div class="mb-4">
                <span class="badge bg-secondary">CONTRATO #@Model.Codigo</span>
                <span class="badge bg-warning text-dark">@Model.Estado.ToUpper()</span>
            </div>

            <div class="p-3 mb-4" style="background: rgba(255,255,255,0.05); border-radius: 8px;">
                <h5 class="text-success fw-bold mb-3">REGISTRAR AVANCE</h5>
                <form action="/Produccion/RegistrarAvance" method="post">
                    <input type="hidden" name="contratoId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="text-secondary small">TIPO DE EVENTO</label>
                        <select name="tipo" class="form-select" required>
                            <option value="AVANCE">🟢 Avance Normal</option>
                            <option value="PROBLEMA">🔴 Incidencia / Problema</option>
                            <option value="FINALIZADO">🏁 FINALIZAR PRODUCCIÓN</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary small">CANTIDAD (Opcional)</label>
                        <input type="number" name="cantidad" class="form-control" placeholder="Ej: 50 prendas cortadas">
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary small">DETALLE</label>
                        <textarea name="detalle" class="form-control" rows="3" placeholder="Descripción del trabajo realizado..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">GUARDAR EN BITÁCORA</button>
                </form>
            </div>
        </div>

        <div class="right-panel">
            <h4 class="mb-4 border-bottom border-secondary pb-2">HISTORIAL DE PRODUCCIÓN</h4>

            @if (historial == null || !historial.Any())
            {
                <div class="text-center text-secondary py-5">
                    <i class="bi bi-clock-history display-1 opacity-25"></i>
                    <p class="mt-3">Aún no hay movimientos registrados.</p>
                </div>
            }
            else
            {
                @foreach (var mov in historial)
                {
                    <div class="timeline-item">
                        <div class="date-label">@mov.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="msg-box">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                @if (mov.Tipo == "AVANCE")
                                {
                                    <span class="badge badge-avance">AVANCE</span>
                                }
                                else if (mov.Tipo == "PROBLEMA")
                                {

                                    <span class="badge badge-problema">INCIDENCIA</span>
                                }
                                else
                                {

                                    <span class="badge badge-fin">FINALIZADO</span>
                                }

                                @if (mov.Cantidad > 0)
                                {
                                    <span class="text-warning fw-bold">+@mov.Cantidad u.</span>
                                }
                            </div>
                            <p class="m-0 text-white">@mov.Detalle</p>
                        </div>
                    </div>
                }
            }
        </div>

    </div>

</body>
</html>