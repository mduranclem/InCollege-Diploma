@{
    ViewData["Title"] = "Nueva Prenda";
}

<style>
    body {
        background-image: url('/interior.jpeg');
        background-size: cover;
        background-attachment: fixed;
        background-color: #000;
        color: white;
    }

    .form-card {
        background-color: rgba(15, 15, 15, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        padding: 30px;
    }

    .form-control {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid #444;
        color: white;
    }

        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: #1e6f42;
            color: white;
            box-shadow: none;
        }

    .form-label {
        color: #ccc;
    }

    .btn-green {
        background-color: #1e6f42;
        color: white;
        border: none;
        padding: 12px;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

        .btn-green:hover {
            background-color: #145230;
            color: white;
        }

    .header-line {
        border-left: 5px solid #1e6f42;
        padding-left: 15px;
        margin-bottom: 25px;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="header-line">
                <h2 class="fw-bold m-0">NUEVA PRENDA</h2>
                <p class="text-secondary m-0">Registrar un componente individual (Hoja)</p>
            </div>

            <div class="form-card">
                <form action="/Productos/CrearPrenda" method="post">

                    <div class="mb-3">
                        <label class="form-label">Nombre del Producto</label>
                        <input type="text" name="nombre" class="form-control form-control-lg" placeholder="Ej: Campera Egresados 2025" required>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Precio Base ($)</label>
                            <input type="number" name="precio" class="form-control" placeholder="0.00" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tipo de Tela</label>
                            <input type="text" name="tela" class="form-control" placeholder="Ej: Algodón Frisado" required>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-green shadow">
                            <i class="bi bi-save"></i> Guardar Prenda
                        </button>
                        <a href="/Productos/Index" class="btn btn-outline-secondary border-0">Cancelar</a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>
