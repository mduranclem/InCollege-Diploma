@model InCollege.Web.Models.GestionUsuariosViewModel
@{
    ViewData["Title"] = "RRHH - Gestión de Personal"; Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recursos Humanos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 30px;
        }

        .section-card {
            background-color: rgba(15, 15, 15, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            margin-bottom: 40px;
        }

        h4 {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
            border-left: 5px solid;
            padding-left: 15px;
        }

        .title-pending {
            color: #ffc107;
            border-color: #ffc107;
        }
        /* Amarillo para pendientes */
        .title-active {
            color: #1e6f42;
            border-color: #1e6f42;
        }
        /* Verde para activos */

        /* Tablas */
        .table-hr {
            width: 100%;
            border-collapse: collapse;
        }

            .table-hr th {
                text-align: left;
                padding: 15px;
                border-bottom: 2px solid #444;
                color: #888;
                text-transform: uppercase;
                font-size: 0.85rem;
            }

            .table-hr td {
                padding: 15px;
                border-bottom: 1px solid #333;
                color: white;
                vertical-align: middle;
            }

            .table-hr tr:hover {
                background-color: rgba(255,255,255,0.03);
            }

        /* Controles */
        .role-select {
            background-color: #111;
            color: white;
            border: 1px solid #555;
            padding: 5px;
            border-radius: 4px;
            font-size: 0.9rem;
        }

        .btn-action {
            padding: 6px 12px;
            border-radius: 4px;
            border: none;
            font-weight: bold;
            font-size: 0.85rem;
            transition: 0.2s;
        }

        .btn-approve {
            background-color: #198754;
            color: white;
        }

            .btn-approve:hover {
                background-color: #146c43;
            }

        .btn-reject {
            background-color: transparent;
            border: 1px solid #dc3545;
            color: #dc3545;
        }

            .btn-reject:hover {
                background-color: #dc3545;
                color: white;
            }

        .btn-save-role {
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            margin-left: 5px;
        }
    </style>
</head>
<body>

    <div class="container" style="max-width: 1200px;">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold m-0 text-white">GESTIÓN DE PERSONAL</h1>
            <a href="/Home/PanelAdmin" class="btn btn-outline-light px-4">VOLVER AL PANEL</a>
        </div>

        @if (Model.Pendientes.Any())
        {
            <div class="section-card" style="border: 1px solid #ffc107;">
                <h4 class="title-pending">Solicitudes Pendientes (@Model.Pendientes.Count)</h4>
                <table class="table-hr">
                    <thead><tr><th>Nombre</th><th>Email</th><th>Asignar Rol</th><th class="text-end">Acción</th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.Pendientes)
                        {
                            <tr>
                                <td class="fw-bold">@u.Apellido, @u.Nombre</td>
                                <td class="text-info">@u.Email</td>

                                <form action="/Usuarios/Aprobar" method="post">
                                    <input type="hidden" name="id" value="@u.Id" />
                                <td>
                                    <select name="rolAsignado" class="role-select">
                                        <option value="Vendedor">Vendedor</option>
                                        <option value="Administrador">Administrador</option>
                                        <option value="Taller">Taller / Producción</option>
                                        <option value="Diseñador">Diseñador</option>
                                    </select>
                                </td>
                                <td class="text-end">
                                    <button type="submit" class="btn-action btn-approve me-2">ACEPTAR</button>
                                    <button type="submit" formaction="/Usuarios/Eliminar" class="btn-action btn-reject">RECHAZAR</button>
                                </td>
                                </form>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-dark border-secondary text-center mb-5 text-secondary">
                <i class="bi bi-check-circle me-2"></i> No hay solicitudes nuevas pendientes de revisión.
            </div>
        }

        <div class="section-card">
            <h4 class="title-active">Personal Activo (@Model.Activos.Count)</h4>
            <table class="table-hr">
                <thead><tr><th>Nombre</th><th>Email</th><th>Rol Actual</th><th class="text-end">Administrar</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Activos)
                    {
                        <tr>
                            <td class="fw-bold text-white">@u.Apellido, @u.Nombre</td>
                            <td class="text-secondary">@u.Email</td>

                            <td>
                                <form action="/Usuarios/CambiarRol" method="post" class="d-flex align-items-center">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <select name="nuevoRol" class="role-select" style="border-color: #444;">
                                        <!option value="Vendedor" @(u.Rol == "Vendedor" ? "selected" : "")>Vendedor</!option>
                                        <!option value="Administrador" @(u.Rol == "Administrador" ? "selected" : "")>Administrador</!option>
                                        <!option value="Taller" @(u.Rol == "Taller" ? "selected" : "")>Taller</!option>
                                        <!option value="Diseñador" @(u.Rol == "Diseñador" ? "selected" : "")>Diseñador</!option>
                                    </select>
                                    <button type="submit" class="btn-save-role" title="Guardar Rol"><i class="bi bi-floppy"></i></button>
                                </form>
                            </td>

                            <td class="text-end">
                                <form action="/Usuarios/Eliminar" method="post" onsubmit="return confirm('¿Despedir a este usuario? Se perderá su acceso.');">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-outline-danger btn-sm border-0"><i class="bi bi-trash"></i> Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</body>
</html>