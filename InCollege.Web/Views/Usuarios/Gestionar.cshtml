@model InCollege.Web.Models.GestionUsuariosViewModel
@{
    ViewData["Title"] = "RRHH - Gestión de Personal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recursos Humanos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 30px;
        }

        .section-card {
            background-color: rgba(15, 15, 15, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            margin-bottom: 40px;
        }

        h4 {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
            border-left: 5px solid;
            padding-left: 15px;
        }

        .title-pending {
            color: #ffc107;
            border-color: #ffc107;
        }

        .title-active {
            color: #1e6f42;
            border-color: #1e6f42;
        }

        /* Tablas */
        .table-hr {
            width: 100%;
            border-collapse: collapse;
        }

            .table-hr th {
                text-align: left;
                padding: 15px;
                border-bottom: 2px solid #444;
                color: #888;
                text-transform: uppercase;
                font-size: 0.85rem;
            }

            .table-hr td {
                padding: 15px;
                border-bottom: 1px solid #333;
                color: white;
                vertical-align: middle;
            }

            .table-hr tr:hover {
                background-color: rgba(255,255,255,0.03);
            }

        /* Controles */
        .role-select {
            background-color: #111;
            color: white;
            border: 1px solid #555;
            padding: 5px;
            border-radius: 4px;
            font-size: 0.85rem;
        }

            .role-select:focus {
                border-color: #1e6f42;
                outline: none;
            }

        .btn-action {
            padding: 6px 12px;
            border-radius: 4px;
            border: none;
            font-weight: bold;
            font-size: 0.85rem;
            transition: 0.2s;
        }

        .btn-approve {
            background-color: #198754;
            color: white;
        }

            .btn-approve:hover {
                background-color: #146c43;
            }

        .btn-reject {
            background-color: transparent;
            border: 1px solid #dc3545;
            color: #dc3545;
        }

            .btn-reject:hover {
                background-color: #dc3545;
                color: white;
            }

        .btn-save-role {
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            margin-left: 5px;
        }

            .btn-save-role:hover {
                background-color: #0b5ed7;
            }
    </style>
</head>
<body>

    <div class="container" style="max-width: 1300px;">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold m-0 text-white">GESTIÓN DE PERSONAL</h1>
            <a href="/Home/PanelAdmin" class="btn btn-outline-light px-4">VOLVER AL PANEL</a>
        </div>

        @if (Model.Pendientes.Any())
        {
            <div class="section-card" style="border: 1px solid #ffc107;">
                <h4 class="title-pending">Solicitudes Pendientes (@Model.Pendientes.Count)</h4>
                <div class="table-responsive">
                    <table class="table-hr">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Definir Perfil (Rol + Zona)</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.Pendientes)
                            {
                                <tr>
                                    <td class="fw-bold">@u.Apellido, @u.Nombre</td>
                                    <td class="text-info">@u.Email</td>

                                    <td>
                                        <form action="/Usuarios/Aprobar" method="post" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="id" value="@u.Id" />

                                            <select name="rolAsignado" class="role-select" style="width: 130px;" required>
                                                <option value="" disabled selected>Rol...</option>
                                                <option value="Vendedor">Vendedor</option>
                                                <option value="Producción">Producción</option>
                                                <option value="Gerente">Gerente</option>
                                                <option value="Administrador">Admin</option>
                                            </select>

                                            <select name="zonaAsignada" class="role-select" style="width: 140px;" title="Zona de Venta (Solo para Vendedores)">
                                                <option value="" selected>Sin Zona...</option>
                                                <option value="Norte">Zona Norte</option>
                                                <option value="Sur">Zona Sur</option>
                                                <option value="Oeste">Zona Oeste</option>
                                                <option value="Centro">Zona Centro</option>
                                                <option value="Alrededores">Alrededores</option>
                                            </select>

                                            <button type="submit" class="btn-action btn-approve ms-2" title="Aprobar"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                    </td>

                                    <td class="text-end">
                                        <form action="/Usuarios/Eliminar" method="post" style="display:inline;" onsubmit="return confirm('¿Rechazar solicitud?');">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn-action btn-reject" title="Rechazar"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-dark border-secondary text-center mb-5 text-secondary">
                <i class="bi bi-check-circle me-2"></i> No hay solicitudes nuevas pendientes de revisión.
            </div>
        }

        <div class="section-card">
            <h4 class="title-active">Personal Activo (@Model.Activos.Count)</h4>
            <div class="table-responsive">
                <table class="table-hr">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Configuración (Zona / Rol)</th>
                            <th class="text-end">Administrar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Activos)
                        {
                            <tr>
                                <td class="fw-bold text-white">@u.Apellido, @u.Nombre</td>
                                <td class="text-secondary">@u.Email</td>

                                <td>
                                    <form action="/Usuarios/CambiarRol" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="id" value="@u.Id" />

                                        <select name="nuevaZona" class="role-select text-warning" style="width: 140px;" title="Zona Geográfica">
                                            <option value="-" selected="@(u.Zona == "-" || u.Zona == null)">- (Sin Zona)</option>
                                            <option value="Norte" selected="@(u.Zona == "Norte")">Norte</option>
                                            <option value="Sur" selected="@(u.Zona == "Sur")">Sur</option>
                                            <option value="Oeste" selected="@(u.Zona == "Oeste")">Oeste</option>
                                            <option value="Centro" selected="@(u.Zona == "Centro")">Centro</option>
                                            <option value="Alrededores" selected="@(u.Zona == "Alrededores")">Alrededores</option>
                                        </select>

                                        <select name="nuevoRol" class="role-select" style="border-color: #444; width: 130px;">
                                            <option value="Vendedor" selected="@(u.Rol == "Vendedor")">Vendedor</option>
                                            <option value="Administrador" selected="@(u.Rol == "Administrador")">Administrador</option>
                                            <option value="Producción" selected="@(u.Rol == "Producción")">Producción</option>
                                            <option value="Gerente" selected="@(u.Rol == "Gerente")">Gerente</option>
                                        </select>

                                        <button type="submit" class="btn-save-role" title="Guardar Cambios de Perfil">
                                            <i class="bi bi-floppy"></i>
                                        </button>
                                    </form>
                                </td>

                                <td class="text-end">
                                    <form action="/Usuarios/Eliminar" method="post" onsubmit="return confirm('¿Despedir a este usuario? Se perderá su acceso.');">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button class="btn btn-outline-danger btn-sm border-0"><i class="bi bi-trash"></i> Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>