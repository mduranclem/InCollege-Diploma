@model InCollege.Web.Models.GestionUsuariosViewModel
@{
    ViewData["Title"] = "RRHH - Gestión de Personal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recursos Humanos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 30px;
        }

        .section-card {
            background-color: rgba(15, 15, 15, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            margin-bottom: 40px;
        }

        h4 {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
            border-left: 5px solid;
            padding-left: 15px;
        }

        .title-pending {
            color: #ffc107;
            border-color: #ffc107;
        }

        .title-active {
            color: #1e6f42;
            border-color: #1e6f42;
        }

        /* Tablas */
        .table-hr {
            width: 100%;
            border-collapse: collapse;
        }

            .table-hr th {
                text-align: left;
                padding: 15px;
                border-bottom: 2px solid #444;
                color: #888;
                text-transform: uppercase;
                font-size: 0.85rem;
            }

            .table-hr td {
                padding: 15px;
                border-bottom: 1px solid #333;
                color: white;
                vertical-align: middle;
            }

            .table-hr tr:hover {
                background-color: rgba(255,255,255,0.03);
            }

        /* Controles */
        .role-select {
            background-color: #111;
            color: white;
            border: 1px solid #555;
            padding: 5px;
            border-radius: 4px;
            font-size: 0.85rem;
        }

            .role-select:focus {
                border-color: #1e6f42;
                outline: none;
            }

        .btn-action {
            padding: 6px 12px;
            border-radius: 4px;
            border: none;
            font-weight: bold;
            font-size: 0.85rem;
            transition: 0.2s;
        }

        .btn-approve {
            background-color: #198754;
            color: white;
        }

            .btn-approve:hover {
                background-color: #146c43;
            }

        .btn-reject {
            background-color: transparent;
            border: 1px solid #dc3545;
            color: #dc3545;
        }

            .btn-reject:hover {
                background-color: #dc3545;
                color: white;
            }

        .btn-save-role {
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            margin-left: 5px;
        }

            .btn-save-role:hover {
                background-color: #0b5ed7;
            }
    </style>
</head>
<body>

    <div class="container" style="max-width: 1300px;">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold m-0 text-white">GESTIÓN DE PERSONAL</h1>
            <a href="/Home/PanelAdmin" class="btn btn-outline-light px-4">VOLVER AL PANEL</a>
        </div>

        @if (Model.Pendientes.Any())
        {
            <div class="section-card" style="border: 1px solid #ffc107;">
                <h4 class="title-pending">Solicitudes Pendientes (@Model.Pendientes.Count)</h4>
                <div class="table-responsive">
                    <table class="table-hr">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Definir Perfil (Rol + Zona)</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Pendientes)
                            {
                                <tr>
                                    <td class="align-middle text-white fw-bold">@item.Apellido, @item.Nombre</td>
                                    <td class="align-middle text-secondary">@item.Email</td>

                                    <td class="align-middle" colspan="2">
                                        <form asp-action="AprobarUsuario" method="post" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="userId" value="@item.Id" />

                                            <select name="rol" id="rol-@item.Id" class="form-select bg-dark text-white border-secondary btn-sm"
                                                    required onchange="mostrarZona('@item.Id')">
                                                <option value="" disabled selected>Rol...</option>
                                                <option value="Vendedor">Vendedor</option>
                                                <option value="Producción">Producción</option>
                                                <option value="Gerente">Gerente</option>
                                                <option value="Admin">Admin</option>
                                                <option value="Disenador">Diseñador</option>
                                            </select>

                                            <div id="div-zona-@item.Id" style="display: none;">
                                                <select name="zona" class="form-select bg-dark text-white border-secondary btn-sm">
                                                    <option value="" selected>Sin Zona...</option>
                                                    <option value="Norte">Norte</option>
                                                    <option value="Sur">Sur</option>
                                                    <option value="Este">Este</option>
                                                    <option value="Oeste">Oeste</option>
                                                    <option value="Centro">Centro</option>
                                                </select>
                                            </div>

                                            <button type="submit" class="btn btn-success btn-sm" title="Aprobar">
                                                <i class="bi bi-check-lg"></i>
                                            </button>

                                            <a asp-action="EliminarUsuario" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"
                                               onclick="return confirm('¿Rechazar solicitud?');" title="Rechazar">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <script>
                            function mostrarZona(idUsuario) {
                                // Obtenemos el valor del rol seleccionado
                                var rolSeleccionado = document.getElementById('rol-' + idUsuario).value;

                                // Obtenemos la cajita de la zona
                                var divZona = document.getElementById('div-zona-' + idUsuario);

                                // Si es Vendedor, mostramos la zona. Si no, la ocultamos.
                                if (rolSeleccionado === 'Vendedor') {
                                    divZona.style.display = 'block';
                                    divZona.querySelector('select').setAttribute('required', 'required'); // Hacemos obligatorio elegir zona
                                } else {
                                    divZona.style.display = 'none';
                                    divZona.querySelector('select').removeAttribute('required'); // Ya no es obligatorio
                                    divZona.querySelector('select').value = ""; // Limpiamos la selección
                                }
                            }
                        </script>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-dark border-secondary text-center mb-5 text-secondary">
                <i class="bi bi-check-circle me-2"></i> No hay solicitudes nuevas pendientes de revisión.
            </div>
        }

        <div class="section-card">
            <h4 class="title-active">Personal Activo (@Model.Activos.Count)</h4>
            <div class="table-responsive">
                <table class="table-hr">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Configuración (Zona / Rol)</th>
                            <th class="text-end">Administrar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Activos)
                        {
                            <tr>
                                <td class="align-middle text-white fw-bold">@item.Apellido, @item.Nombre</td>
                                <td class="align-middle text-secondary">@item.Email</td>

                                <td class="align-middle">
                                    <form asp-action="ActualizarUsuario" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="userId" value="@item.Id" />

                                        <select id="zona-@item.Id" name="zona" class="form-select bg-dark text-white border-secondary btn-sm"
                                                style="width: 110px; display: @(item.Rol == "Vendedor" ? "block" : "none");">
                                            <option value="" selected="@(string.IsNullOrEmpty(item.Zona))">- (Sin Zona)</option>
                                            <option value="Norte" selected="@(item.Zona == "Norte")">Norte</option>
                                            <option value="Sur" selected="@(item.Zona == "Sur")">Sur</option>
                                            <option value="Este" selected="@(item.Zona == "Este")">Este</option>
                                            <option value="Oeste" selected="@(item.Zona == "Oeste")">Oeste</option>
                                            <option value="Centro" selected="@(item.Zona == "Centro")">Centro</option>
                                        </select>

                                        <select id="rol-@item.Id" name="rol" class="form-select bg-dark text-white border-secondary btn-sm"
                                                style="width: 130px;" onchange="toggleZonaActivo('@item.Id')">
                                            <option value="Vendedor" selected="@(item.Rol == "Vendedor")">Vendedor</option>
                                            <option value="Producción" selected="@(item.Rol == "Producción")">Producción</option>
                                            <option value="Gerente" selected="@(item.Rol == "Gerente")">Gerente</option>
                                            <option value="Admin" selected="@(item.Rol == "Admin")">Administrador</option>
                                            <option value="Disenador" selected="@(item.Rol == "Disenador")">Diseñador</option>
                                        </select>

                                        <button type="submit" class="btn btn-primary btn-sm" title="Guardar Cambios">
                                            <i class="bi bi-floppy"></i>
                                        </button>
                                    </form>
                                </td>

                                <td class="align-middle text-end">
                                    <a asp-action="EliminarUsuario" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('¿Eliminar usuario del sistema?');">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <script>
                        // Función para la tabla de PERSONAL ACTIVO
                        function toggleZonaActivo(idUsuario) {
                            // Buscamos los elementos por su ID único
                            var selectRol = document.getElementById('rol-' + idUsuario);
                            var selectZona = document.getElementById('zona-' + idUsuario);

                            // Si elige Vendedor, mostramos la zona. Si no, la ocultamos.
                            if (selectRol.value === 'Vendedor') {
                                selectZona.style.display = 'block';
                            } else {
                                selectZona.style.display = 'none';
                                selectZona.value = ""; // Opcional: limpiar la zona si deja de ser vendedor
                            }
                        }
                    </script>
                </table>
            </div>
        </div>

    </div>

</body>
</html>