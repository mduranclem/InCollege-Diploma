@using InCollege.Dominio.Modelos
@model List<Usuario>

@{
    ViewData["Title"] = "Solicitudes Pendientes";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Solicitudes de Acceso</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #000;
            color: white;
            background-image: url('/interior.jpeg');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
            padding: 40px;
        }

        .main-card {
            background-color: rgba(15, 15, 15, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            max-width: 1000px;
            margin: 0 auto;
        }

        .table-req {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

            .table-req th {
                text-align: left;
                padding: 15px;
                border-bottom: 2px solid #444;
                color: #888;
                text-transform: uppercase;
                font-size: 0.9rem;
            }

            .table-req td {
                padding: 15px;
                border-bottom: 1px solid #333;
                color: white;
                vertical-align: middle;
            }

        .btn-back {
            color: #ccc;
            text-decoration: none;
            font-weight: 600;
            border: 1px solid #555;
            padding: 8px 15px;
            border-radius: 6px;
        }

            .btn-back:hover {
                background-color: #222;
                color: white;
                border-color: white;
            }
    </style>
</head>
<body>

    <div class="main-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold m-0 border-start border-5 border-warning ps-3 text-warning">SOLICITUDES PENDIENTES</h2>
            <a href="/Home/PanelAdmin" class="btn-back">Volver al Panel</a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-check-circle display-1 opacity-25 text-success"></i>
                <h4 class="mt-3">No hay solicitudes pendientes.</h4>
                <p>Todo el personal está al día.</p>
            </div>
        }
        else
        {
            <table class="table-req">
                <thead>
                    <tr>
                        <th>NOMBRE COMPLETO</th>
                        <th>EMAIL</th>
                        <th class="text-end">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold fs-5">@u.Apellido, @u.Nombre</td>
                            <td class="text-info">@u.Email</td>
                            <td class="text-end">
                                <form action="/Usuarios/Aprobar" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-success btn-sm me-2 fw-bold px-3 shadow">APROBAR</button>
                                </form>
                                <form action="/Usuarios/Rechazar" method="post" class="d-inline" onsubmit="return confirm('¿Rechazar solicitud?');">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-outline-danger btn-sm px-3">Rechazar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>

</body>
</html>